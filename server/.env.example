# ─────────────────────────────────────────────
# Nexora Backend — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to production

# ─── Database ─────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/nexora"

# ─── Auth ─────────────────────────────────────
JWT_SECRET="change-me-in-production"
COOKIE_NAME="nexora_token"

# ─── CORS ─────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ─── Email (SMTP) ─────────────────────────────
# Leave empty to disable email (logs to console instead)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nexora.io"
# Admin email to notify on new requests
ADMIN_NOTIFY_EMAIL=""
