// This is your Prisma schema file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequestStatus {
  CREATED
  WAITING_PAYMENT
  CRYPTO_RECEIVED
  AML_REVIEW
  READY_FOR_PAYOUT
  PROCESSING
  COMPLETED
  ON_HOLD
}

enum AmlStatus {
  PENDING
  PASSED
  REVIEW
  REJECTED
}

enum PayoutStatus {
  PENDING
  READY
  PROCESSING
  COMPLETED
  FAILED
  ON_HOLD
}

enum PartnerStatus {
  ACTIVE
  LIMITED
  LOW_RESERVE
  PAUSED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  role      Role       @default(OPERATOR)
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
}

model Client {
  id          String    @id @default(cuid())
  companyName String
  country     String
  riskLevel   RiskLevel @default(LOW)
  createdAt   DateTime  @default(now())
  requests    Request[]
}

model ClientAccount {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  requests      Request[]
  notifications Notification[]
}

model Request {
  id             String        @id @default(cuid())
  requestNumber  String        @unique
  status         RequestStatus @default(CREATED)
  cryptoAsset    String
  network        String
  cryptoAmount   Decimal  @db.Decimal(18,2)
  payoutCurrency String
  payoutAmount   Decimal  @db.Decimal(18,2)
  rateSnapshot   Decimal? @db.Decimal(18,8)

  nexoraFeePercent  Decimal  @default(2.0) @db.Decimal(5,2)
  nexoraFeeAmount   Decimal? @db.Decimal(18,2)
  partnerFeePercent Decimal  @default(1.0) @db.Decimal(5,2)
  partnerFeeAmount  Decimal? @db.Decimal(18,2)
  grossProfit       Decimal? @db.Decimal(18,2)
  netPayoutAmount   Decimal? @db.Decimal(18,2)

  amlStatus      AmlStatus @default(PENDING)
  riskScore      Int?
  amlComment     String?
  amlReviewedAt  DateTime?
  amlReviewedBy  String?

  country           String?
  recipientDetails  String?   // JSON: { cardNumber, bankName, recipientName, phone? }
  walletAddress     String?   // Crypto wallet set by admin for this request

  createdAt      DateTime      @default(now())

  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id])
  payout          Payout?
  proofUploads    ProofUpload[]
  statusHistory   RequestStatusHistory[]
}

model Payout {
  id           String       @id @default(cuid())
  payoutNumber String       @unique
  status       PayoutStatus @default(PENDING)
  amount       Decimal  @db.Decimal(18,2)
  currency     String
  createdAt    DateTime     @default(now())

  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id])

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
}

model Partner {
  id         String        @id @default(cuid())
  name       String
  country    String
  currency   String
  reserve    Decimal  @db.Decimal(18,2)
  feePercent Decimal  @db.Decimal(5,2)
  status     PartnerStatus @default(ACTIVE)
  payouts    Payout[]
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String
  entityId     String
  operatorName String
  createdAt    DateTime @default(now())

  operatorId String?
  operator   User?   @relation(fields: [operatorId], references: [id])
}

model ProofUpload {
  id           String   @id @default(cuid())
  requestId    String
  request      Request  @relation(fields: [requestId], references: [id])
  filename     String
  originalName String
  mimeType     String
  size         Int
  uploadedAt   DateTime @default(now())
}

model Notification {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id])
  requestId       String?
  message         String
  isRead          Boolean       @default(false)
  createdAt       DateTime      @default(now())
}

model RequestStatusHistory {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id])
  fromStatus String
  toStatus   String
  changedBy  String
  createdAt  DateTime @default(now())
}
